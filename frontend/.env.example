# URL the browser uses to reach the FastAPI backend (no trailing slash).
# Local dev: http://localhost:8000
# EC2 (VPN/private IP in browser): http://<instance-private-ip>:8000  (not localhost — that is your laptop)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated hostnames only (no http, no port) for Next.js dev cross-origin allowlist when you open the app by IP/DNS.
NEXT_ALLOWED_DEV_ORIGINS=10.0.1.62,192.168.228.91

# Copilot Cloud public key (ck_pub_...) — enables observability hooks (e.g. onFeedbackGiven). 
NEXT_PUBLIC_COPILOT_PUBLIC_API_KEY=ck_pub_e0dd5b0babe1d0a6203b5ac4032ecb20